# =============================================================
# NEXUS INGENIERÍA — Plataforma web
# Archivo de ejemplo de variables de entorno
# =============================================================
# Copia este archivo como .env.local y completa los valores
# reales. NUNCA subas .env.local al repositorio.
# =============================================================

# --- Supabase (supabase.com → proyecto → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Solo servidor (NUNCA con prefijo NEXT_PUBLIC_) ---
# Supabase → Project Settings → API → service_role. Necesaria para que los
# clientes firmen por enlace, para verificar PDFs y para sellar las firmas.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
